@namespace AcademicHybridApp.Components.Shared

<div class="card error-state">
    <span class="error-state__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 8.5a14.5 14.5 0 0 1 17 0" />
            <path d="M6.5 12a10 10 0 0 1 11 0" />
            <path d="M9.5 15.4a5 5 0 0 1 5 0" />
            <path d="M12 19h.01" />
            <path d="m4 4 16 16" />
        </svg>
    </span>
    <h3 class="error-state__title">@Title</h3>
    <p class="error-state__text">@Message</p>
    @if (OnRetry.HasDelegate)
    {
        <button class="btn btn-primary btn--sm" type="button" @onclick="RetryAsync">Coba Lagi</button>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Tidak dapat terhubung";

    [Parameter]
    public string Message { get; set; } = "Tidak dapat terhubung ke server. Pastikan API sudah berjalan.";

    [Parameter]
    public EventCallback OnRetry { get; set; }

    private async Task RetryAsync()
    {
        await OnRetry.InvokeAsync();
    }
}
