@page "/"
@using AcademicHybridApp.Models
@using AcademicHybridApp.Services
@inject IDosenService DosenService
@inject IMahasiswaService MahasiswaService

<div class="page-head">
    <p class="eyebrow">@TanggalHariIni</p>
    <h1 class="page-title">Administrasi Akademik</h1>
    <p class="page-subtitle">
        Selamat datang kembali. Berikut ringkasan data dosen dan mahasiswa yang tersimpan
        di sistem akademik.
    </p>
</div>

@if (_isLoading)
{
    <section class="preview-section" aria-label="Memuat ringkasan akademik">
        <LoadingState Count="2" />
    </section>
}
else if (_errorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data akademik belum tersedia"
                    Message="@_errorMessage"
                    OnRetry="LoadAsync" />
    </section>
}
else
{
    <section class="dashboard-stats" aria-label="Statistik akademik">
        <article class="stat-card stat-card--dosen">
            <span class="stat-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 2.5 7.5 12 12l9.5-4.5L12 3Z" />
                    <path d="M6.5 10v4.5c0 1.8 2.5 3.5 5.5 3.5s5.5-1.7 5.5-3.5V10" />
                    <path d="M21.5 7.5v5" />
                </svg>
            </span>
            <p class="stat-card__label">Total Dosen</p>
            <p class="stat-card__value">@_dosen.Count</p>
            <p class="stat-card__hint">Dosen terdaftar</p>
        </article>

        <article class="stat-card stat-card--mahasiswa">
            <span class="stat-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.2" />
                    <path d="M3.5 20c0-3 2.5-5.2 5.5-5.2s5.5 2.2 5.5 5.2" />
                    <path d="M16 5.3a3.2 3.2 0 0 1 0 5.4" />
                    <path d="M17.5 14.9c2.1.7 3.5 2.5 3.5 5.1" />
                </svg>
            </span>
            <p class="stat-card__label">Total Mahasiswa</p>
            <p class="stat-card__value">@_mahasiswa.Count</p>
            <p class="stat-card__hint">Mahasiswa terdaftar</p>
        </article>
    </section>

    <section class="preview-section">
        <div class="section-heading">
            <h2 class="section-title">Mahasiswa terbaru</h2>
            <a class="text-link" href="mahasiswa">Lihat semua</a>
        </div>

        @if (_latestMahasiswa.Count == 0)
        {
            <EmptyState Title="Belum ada mahasiswa"
                        Message="Data mahasiswa terbaru akan muncul di sini setelah ditambahkan.">
                <a class="btn btn-primary btn--sm" href="mahasiswa/tambah">Tambah mahasiswa</a>
            </EmptyState>
        }
        else
        {
            <div class="card dashboard-recent">
                @foreach (var mahasiswa in _latestMahasiswa)
                {
                    <div class="recent-item">
                        <InitialsAvatar Name="@mahasiswa.NamaMahasiswa" />
                        <div class="recent-item__content">
                            <p class="recent-item__name">@mahasiswa.NamaMahasiswa</p>
                            <p class="recent-item__meta">
                                @mahasiswa.Nim · Wali: @mahasiswa.NamaDosenWali
                            </p>
                        </div>
                        <span class="badge badge--neutral">@mahasiswa.Angkatan</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="preview-section">
        <div class="section-heading">
            <h2 class="section-title">Pintasan</h2>
        </div>
        <div class="dashboard-actions">
            <a class="btn btn-primary" href="dosen/tambah">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3 2.5 7.5 12 12l9.5-4.5L12 3Z" />
                    <path d="M6.5 10v4.5c0 1.8 2.5 3.5 5.5 3.5s5.5-1.7 5.5-3.5V10" />
                    <path d="M21.5 7.5v5" />
                </svg>
                Tambah Dosen
            </a>
            <a class="btn btn-ghost" href="mahasiswa/tambah">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="7.5" r="3" />
                    <path d="M3.5 19c0-2.8 2.5-4.8 5.5-4.8s5.5 2 5.5 4.8" />
                    <path d="M18 8v6M15 11h6" />
                </svg>
                Tambah Mahasiswa
            </a>
        </div>
    </section>
}

@code {
    private static readonly string[] _namaHari =
    {
        "Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"
    };

    private static readonly string[] _namaBulan =
    {
        "Januari", "Februari", "Maret", "April", "Mei", "Juni",
        "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    };

    private List<DosenModel> _dosen = new();
    private List<MahasiswaModel> _mahasiswa = new();
    private List<MahasiswaModel> _latestMahasiswa = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private string TanggalHariIni
    {
        get
        {
            var today = DateTime.Today;
            return $"{_namaHari[(int)today.DayOfWeek]}, {today.Day} {_namaBulan[today.Month - 1]} {today.Year}";
        }
    }

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var dosenTask = DosenService.GetAllAsync();
            var mahasiswaTask = MahasiswaService.GetAllAsync();

            await Task.WhenAll(dosenTask, mahasiswaTask);

            var dosenResult = await dosenTask;
            var mahasiswaResult = await mahasiswaTask;

            if (!dosenResult.Success)
            {
                _errorMessage = dosenResult.Message;
                return;
            }

            if (!mahasiswaResult.Success)
            {
                _errorMessage = mahasiswaResult.Message;
                return;
            }

            _dosen = dosenResult.Data ?? new List<DosenModel>();
            _mahasiswa = mahasiswaResult.Data ?? new List<MahasiswaModel>();
            _latestMahasiswa = _mahasiswa
                .OrderByDescending(mahasiswa => mahasiswa.MahasiswaId)
                .Take(3)
                .ToList();
        }
        catch (Exception)
        {
            _errorMessage = "Tidak dapat terhubung ke server. Pastikan API sudah berjalan.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
