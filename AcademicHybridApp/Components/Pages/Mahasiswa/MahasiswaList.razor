@page "/mahasiswa"
@inherits EntityListPageBase<MahasiswaModel>
@inject IMahasiswaService MahasiswaService
@using System.Timers
@implements IDisposable

<div class="page-head">
    <p class="eyebrow">Data akademik</p>
    <h1 class="page-title">Mahasiswa</h1>
    <p class="page-subtitle">
        Kelola data mahasiswa, mulai dari NIM, nama, email, angkatan, hingga dosen wali.
    </p>
</div>

<section class="preview-section" aria-label="Filter dan pencarian mahasiswa">
    <div class="filter-bar">
        <div class="filter-bar__group filter-bar__group--search">
            <label class="form-label" for="mahasiswa-search">Cari</label>
            <input id="mahasiswa-search" class="form-input" type="search" placeholder="Cari NIM atau nama..." @bind="SearchTerm" @bind:event="oninput" />
        </div>
        <div class="filter-bar__group">
            <label class="form-label" for="mahasiswa-sortby">Urut berdasarkan</label>
            <select id="mahasiswa-sortby" class="form-select" @bind="SortBy">
                <option value="nama">Nama</option>
                <option value="angkatan">Angkatan</option>
            </select>
        </div>
        <div class="filter-bar__group">
            <label class="form-label" for="mahasiswa-sortdir">Arah</label>
            <select id="mahasiswa-sortdir" class="form-select" @bind="SortDir">
                <option value="asc">Naik</option>
                <option value="desc">Turun</option>
            </select>
        </div>
    </div>
</section>

@if (IsLoading)
{
    <section class="preview-section" aria-label="Memuat data mahasiswa">
        <LoadingState Count="2" />
    </section>
}
else if (ErrorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data mahasiswa gagal dimuat"
                    Message="@ErrorMessage"
                    OnRetry="LoadAsync" />
    </section>
}
else if (Items.Count == 0)
{
    <section class="preview-section">
        @if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            <EmptyState Title="Tidak ada hasil"
                        Message="Tidak ada mahasiswa yang cocok dengan pencarian Anda." />
        }
        else
        {
            <EmptyState Title="Belum ada data mahasiswa"
                        Message="Mulai dengan menambahkan mahasiswa pertama ke sistem akademik.">
                <a class="btn btn-primary btn--sm" href="/mahasiswa/tambah">Tambah Mahasiswa</a>
            </EmptyState>
        }
    </section>
}
else
{
    <section class="preview-section mahasiswa-list" aria-label="Daftar mahasiswa">
        @foreach (var mahasiswa in Items)
        {
            <article class="card mahasiswa-card">
                <div class="card__header">
                    <InitialsAvatar Name="@mahasiswa.NamaMahasiswa" Size="lg" />
                    <div class="card__heading">
                        <h2 class="card__title">@mahasiswa.NamaMahasiswa</h2>
                        <p class="card__meta">NIM @mahasiswa.Nim</p>
                    </div>
                    <span class="badge badge--neutral">@mahasiswa.Angkatan</span>
                </div>

                <p class="mahasiswa-card__email">@mahasiswa.Email</p>
                <p class="mahasiswa-card__wali">
                    Dosen wali: <strong>@mahasiswa.NamaDosenWali</strong>
                </p>

                <div class="card__footer">
                    <div class="card__actions">
                        <button class="btn btn-ghost btn--sm" type="button" @onclick="() => NavigateToEdit(mahasiswa)">
                            Edit
                        </button>
                        <button class="btn btn-danger btn--sm" type="button" @onclick="() => OpenDeleteDialog(mahasiswa)">
                            Hapus
                        </button>
                    </div>
                </div>
            </article>
        }
    </section>

    <section class="preview-section pagination-section" aria-label="Navigasi halaman">
        <div class="pagination">
            <button class="btn btn-ghost btn--sm" type="button" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">Sebelumnya</button>
            <span class="pagination__info">Halaman @CurrentPage dari @TotalPages</span>
            <button class="btn btn-ghost btn--sm" type="button" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">Berikutnya</button>
        </div>
    </section>

    <button class="fab" type="button" aria-label="Tambah Mahasiswa" @onclick="NavigateToAdd">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </button>
}

<ConfirmDialog Visible="ConfirmVisible"
               Title="Hapus mahasiswa?"
               Message="@DeleteMessage"
               IsProcessing="IsDeleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDelete" />

@code {
    private string _searchTerm = string.Empty;
    private string _sortBy = "nama";
    private string _sortDir = "asc";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private Timer? _debounceTimer;

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _currentPage = 1;
            RestartDebounce();
        }
    }

    private string SortBy
    {
        get => _sortBy;
        set
        {
            if (_sortBy == value) return;
            _sortBy = value;
            _currentPage = 1;
            _ = InvokeAsync(LoadAsync);
        }
    }

    private string SortDir
    {
        get => _sortDir;
        set
        {
            if (_sortDir == value) return;
            _sortDir = value;
            _currentPage = 1;
            _ = InvokeAsync(LoadAsync);
        }
    }

    private int CurrentPage => _currentPage;
    private int TotalPages => _totalCount <= 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)_pageSize);

    protected override string EntityName => "Mahasiswa";

    protected override string AddPath => "/mahasiswa/tambah";

    protected override async Task<ServiceResult<List<MahasiswaModel>>> LoadItemsAsync()
    {
        var result = await MahasiswaService.GetFilteredAsync(
            string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            _sortBy,
            _sortDir,
            _currentPage,
            _pageSize);

        if (result.Success)
        {
            _totalCount = result.TotalCount;
        }
        else if (result.TotalCount == 0)
        {
            _totalCount = 0;
        }

        return result;
    }

    private void RestartDebounce()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(400);
        _debounceTimer.Elapsed += OnDebounceElapsed;
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private void OnDebounceElapsed(object? sender, ElapsedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task PrevPage()
    {
        if (_currentPage <= 1) return;
        _currentPage--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_currentPage >= TotalPages) return;
        _currentPage++;
        await LoadAsync();
    }

    protected override Task<ServiceResult> DeleteItemAsync(MahasiswaModel item)
    {
        return MahasiswaService.DeleteAsync(item.MahasiswaId);
    }

    protected override string GetItemName(MahasiswaModel item)
    {
        return item.NamaMahasiswa;
    }

    protected override string GetEditPath(MahasiswaModel item)
    {
        return $"/mahasiswa/edit/{item.MahasiswaId}";
    }

    public void Dispose()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
    }
}
