@page "/mahasiswa"
@inject IMahasiswaService MahasiswaService
@inject ToastService ToastService
@inject NavigationManager Navigation

<div class="page-head">
    <p class="eyebrow">Data akademik</p>
    <h1 class="page-title">Mahasiswa</h1>
    <p class="page-subtitle">
        Kelola data mahasiswa, mulai dari NIM, nama, email, angkatan, hingga dosen wali.
    </p>
</div>

@if (_isLoading)
{
    <section class="preview-section" aria-label="Memuat data mahasiswa">
        <LoadingState Count="2" />
    </section>
}
else if (_errorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data mahasiswa gagal dimuat"
                    Message="@_errorMessage"
                    OnRetry="LoadAsync" />
    </section>
}
else if (_mahasiswa.Count == 0)
{
    <section class="preview-section">
        <EmptyState Title="Belum ada data mahasiswa"
                    Message="Mulai dengan menambahkan mahasiswa pertama ke sistem akademik.">
            <a class="btn btn-primary btn--sm" href="/mahasiswa/tambah">Tambah Mahasiswa</a>
        </EmptyState>
    </section>
}
else
{
    <section class="preview-section mahasiswa-list" aria-label="Daftar mahasiswa">
        @foreach (var mahasiswa in _mahasiswa)
        {
            <article class="card mahasiswa-card">
                <div class="card__header">
                    <InitialsAvatar Name="@mahasiswa.NamaMahasiswa" Size="lg" />
                    <div class="card__heading">
                        <h2 class="card__title">@mahasiswa.NamaMahasiswa</h2>
                        <p class="card__meta">NIM @mahasiswa.Nim</p>
                    </div>
                    <span class="badge badge--neutral">@mahasiswa.Angkatan</span>
                </div>

                <p class="mahasiswa-card__email">@mahasiswa.Email</p>
                <p class="mahasiswa-card__wali">
                    Dosen wali: <strong>@mahasiswa.NamaDosenWali</strong>
                </p>

                <div class="card__footer">
                    <div class="card__actions">
                        <button class="btn btn-ghost btn--sm" type="button" @onclick="() => NavigateToEdit(mahasiswa.MahasiswaId)">
                            Edit
                        </button>
                        <button class="btn btn-danger btn--sm" type="button" @onclick="() => OpenDeleteDialog(mahasiswa)">
                            Hapus
                        </button>
                    </div>
                </div>
            </article>
        }
    </section>

    <button class="fab" type="button" aria-label="Tambah Mahasiswa" @onclick="NavigateToAdd">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </button>
}

<ConfirmDialog Visible="_confirmVisible"
               Title="Hapus mahasiswa?"
               Message="@DeleteMessage"
               IsProcessing="_isDeleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDelete" />

@code {
    private List<MahasiswaModel> _mahasiswa = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private MahasiswaModel? _mahasiswaToDelete;
    private bool _confirmVisible;
    private bool _isDeleting;

    private string DeleteMessage => _mahasiswaToDelete is null
        ? "Data mahasiswa akan dihapus permanen dan tidak dapat dikembalikan."
        : $"Data mahasiswa {_mahasiswaToDelete.NamaMahasiswa} akan dihapus permanen dan tidak dapat dikembalikan.";

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        await FetchAsync();

        _isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        await FetchAsync();
        StateHasChanged();
    }

    private async Task FetchAsync()
    {
        try
        {
            var result = await MahasiswaService.GetAllAsync();

            if (result.Success)
            {
                _mahasiswa = result.Data ?? new List<MahasiswaModel>();
                _errorMessage = null;
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Tidak dapat terhubung ke server. Pastikan API sudah berjalan.";
        }
    }

    private void NavigateToAdd()
    {
        Navigation.NavigateTo("/mahasiswa/tambah");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/mahasiswa/edit/{id}");
    }

    private void OpenDeleteDialog(MahasiswaModel mahasiswa)
    {
        _mahasiswaToDelete = mahasiswa;
        _isDeleting = false;
        _confirmVisible = true;
    }

    private void CancelDelete()
    {
        if (_isDeleting)
        {
            return;
        }

        _confirmVisible = false;
        _mahasiswaToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_mahasiswaToDelete is null || _isDeleting)
        {
            return;
        }

        var mahasiswa = _mahasiswaToDelete;
        _isDeleting = true;
        StateHasChanged();

        var result = await MahasiswaService.DeleteAsync(mahasiswa.MahasiswaId);

        _isDeleting = false;
        _confirmVisible = false;
        _mahasiswaToDelete = null;

        if (result.Success)
        {
            ToastService.ShowSuccess("Mahasiswa berhasil dihapus", result.Message);
            StateHasChanged();
            await RefreshAsync();
        }
        else
        {
            ToastService.ShowError("Gagal menghapus mahasiswa", result.Message);
            StateHasChanged();
        }
    }
}
