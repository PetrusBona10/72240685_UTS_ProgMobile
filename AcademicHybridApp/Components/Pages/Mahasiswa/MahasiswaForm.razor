@page "/mahasiswa/tambah"
@page "/mahasiswa/edit/{Id:int}"
@inherits EntityFormPageBase<MahasiswaFormModel>
@inject IMahasiswaService MahasiswaService
@inject IDosenService DosenService

<div class="page-head">
    <a class="text-link" href="/mahasiswa">← Kembali ke daftar</a>
    <p class="eyebrow">Data mahasiswa</p>
    <h1 class="page-title">@PageTitle</h1>
    <p class="page-subtitle">@PageSubtitle</p>
</div>

@if (IsLoading)
{
    <section class="preview-section" aria-label="Memuat data mahasiswa">
        <LoadingState Count="1" />
    </section>
}
else if (LoadErrorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data mahasiswa tidak dapat dimuat"
                    Message="@LoadErrorMessage"
                    OnRetry="LoadAsync" />
        <a class="btn btn-ghost btn--block" href="/mahasiswa">Kembali ke daftar</a>
    </section>
}
else if (_dosen.Count == 0)
{
    <section class="preview-section">
        <EmptyState Title="Belum ada dosen"
                    Message="Tambahkan data dosen terlebih dahulu sebelum mendaftarkan mahasiswa dan memilih dosen wali.">
            <a class="btn btn-primary btn--sm" href="/dosen/tambah">Tambah Dosen</a>
        </EmptyState>
    </section>
}
else
{
    <EditForm Model="FormModel" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="preview-section">
            <div class="card">
                <div class="form-group">
                    <label class="form-label" for="nim">NIM</label>
                    <InputText class="form-control"
                               id="nim"
                               @bind-Value="FormModel.Nim"
                               placeholder="cth. 22101123" />
                    <ValidationMessage For="() => FormModel.Nim" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="nama">Nama mahasiswa</label>
                    <InputText class="form-control"
                               id="nama"
                               @bind-Value="FormModel.NamaMahasiswa"
                               placeholder="cth. Nadia Putri Lestari" />
                    <ValidationMessage For="() => FormModel.NamaMahasiswa" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <InputText class="form-control"
                               id="email"
                               type="email"
                               @bind-Value="FormModel.Email"
                               placeholder="nama@kampus.ac.id" />
                    <ValidationMessage For="() => FormModel.Email" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="angkatan">Angkatan</label>
                    <InputNumber class="form-control"
                                 id="angkatan"
                                 @bind-Value="FormModel.Angkatan"
                                 min="2020"
                                 max="2026"
                                 placeholder="cth. 2024" />
                    <ValidationMessage For="() => FormModel.Angkatan" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="dosen">Dosen wali</label>
                    <InputSelect class="form-control" id="dosen" @bind-Value="FormModel.DosenId">
                        <option value="0">Pilih dosen wali</option>
                        @foreach (var dosen in _dosen)
                        {
                            <option value="@dosen.DosenId">@dosen.NamaDosen · @dosen.Prodi</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => FormModel.DosenId" />
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" href="/mahasiswa">Batal</a>
                <button class="btn btn-primary" type="submit" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="btn__spinner" aria-hidden="true"></span>
                    }
                    @(IsSaving ? "Menyimpan..." : "Simpan")
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private readonly List<DosenModel> _dosen = new();

    private bool IsEditMode => Id.HasValue;

    private string PageTitle => IsEditMode ? "Edit Mahasiswa" : "Tambah Mahasiswa";

    private string PageSubtitle => IsEditMode
        ? "Perbarui informasi mahasiswa dan dosen wali, lalu simpan perubahan."
        : "Lengkapi informasi mahasiswa baru untuk ditambahkan ke sistem akademik.";

    protected override string ListPath => "/mahasiswa";

    protected override string SaveSuccessTitle => IsEditMode
        ? "Mahasiswa berhasil diperbarui"
        : "Mahasiswa berhasil ditambahkan";

    protected override string SaveErrorTitle => IsEditMode
        ? "Gagal memperbarui mahasiswa"
        : "Gagal menambahkan mahasiswa";

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditMode)
        {
            FormModel.Angkatan = Math.Clamp(DateTime.Today.Year, 2020, 2026);
        }

        await base.OnInitializedAsync();
    }

    protected override async Task LoadFormAsync()
    {
        var dosenTask = DosenService.GetAllAsync();
        var mahasiswaTask = IsEditMode
            ? MahasiswaService.GetByIdAsync(Id!.Value)
            : null;

        if (mahasiswaTask is null)
        {
            await dosenTask;
        }
        else
        {
            await Task.WhenAll(dosenTask, mahasiswaTask);
        }

        var dosenResult = await dosenTask;

        if (!dosenResult.Success)
        {
            LoadErrorMessage = dosenResult.Message;
            return;
        }

        _dosen.Clear();
        _dosen.AddRange((dosenResult.Data ?? new List<DosenModel>())
            .OrderBy(dosen => dosen.NamaDosen));

        if (mahasiswaTask is null)
        {
            return;
        }

        var mahasiswaResult = await mahasiswaTask;

        if (!mahasiswaResult.Success || mahasiswaResult.Data is null)
        {
            LoadErrorMessage = mahasiswaResult.Message;
            return;
        }

        FormModel.Nim = mahasiswaResult.Data.Nim;
        FormModel.NamaMahasiswa = mahasiswaResult.Data.NamaMahasiswa;
        FormModel.Email = mahasiswaResult.Data.Email;
        FormModel.Angkatan = mahasiswaResult.Data.Angkatan;
        FormModel.DosenId = mahasiswaResult.Data.DosenId;
    }

    protected override async Task<ServiceResult> SaveModelAsync()
    {
        if (IsEditMode)
        {
            return await MahasiswaService.UpdateAsync(Id!.Value, FormModel);
        }

        var result = await MahasiswaService.CreateAsync(FormModel);

        return result.Success
            ? ServiceResult.Ok(result.Message)
            : ServiceResult.Fail(result.Message);
    }
}
