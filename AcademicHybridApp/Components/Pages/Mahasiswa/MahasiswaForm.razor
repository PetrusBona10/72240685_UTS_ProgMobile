@page "/mahasiswa/tambah"
@page "/mahasiswa/edit/{Id:int}"
@inject IMahasiswaService MahasiswaService
@inject IDosenService DosenService
@inject ToastService ToastService
@inject NavigationManager Navigation

<div class="page-head">
    <a class="text-link" href="/mahasiswa">← Kembali ke daftar</a>
    <p class="eyebrow">Data mahasiswa</p>
    <h1 class="page-title">@PageTitle</h1>
    <p class="page-subtitle">@PageSubtitle</p>
</div>

@if (_isLoading)
{
    <section class="preview-section" aria-label="Memuat data mahasiswa">
        <LoadingState Count="1" />
    </section>
}
else if (_loadErrorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data mahasiswa tidak dapat dimuat"
                    Message="@_loadErrorMessage"
                    OnRetry="LoadAsync" />
        <a class="btn btn-ghost btn--block" href="/mahasiswa">Kembali ke daftar</a>
    </section>
}
else if (_dosen.Count == 0)
{
    <section class="preview-section">
        <EmptyState Title="Belum ada dosen"
                    Message="Tambahkan data dosen terlebih dahulu sebelum mendaftarkan mahasiswa dan memilih dosen wali.">
            <a class="btn btn-primary btn--sm" href="/dosen/tambah">Tambah Dosen</a>
        </EmptyState>
    </section>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="preview-section">
            <div class="card">
                <div class="form-group">
                    <label class="form-label" for="nim">NIM</label>
                    <InputText class="form-control"
                               id="nim"
                               @bind-Value="_model.Nim"
                               placeholder="cth. 22101123" />
                    <ValidationMessage For="() => _model.Nim" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="nama">Nama mahasiswa</label>
                    <InputText class="form-control"
                               id="nama"
                               @bind-Value="_model.NamaMahasiswa"
                               placeholder="cth. Nadia Putri Lestari" />
                    <ValidationMessage For="() => _model.NamaMahasiswa" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <InputText class="form-control"
                               id="email"
                               type="email"
                               @bind-Value="_model.Email"
                               placeholder="nama@kampus.ac.id" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="angkatan">Angkatan</label>
                    <InputNumber class="form-control"
                                 id="angkatan"
                                 @bind-Value="_model.Angkatan"
                                 min="2020"
                                 max="2026"
                                 placeholder="cth. 2024" />
                    <ValidationMessage For="() => _model.Angkatan" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="dosen">Dosen wali</label>
                    <InputSelect class="form-control" id="dosen" @bind-Value="_model.DosenId">
                        <option value="0">Pilih dosen wali</option>
                        @foreach (var dosen in _dosen)
                        {
                            <option value="@dosen.DosenId">@dosen.NamaDosen · @dosen.Prodi</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.DosenId" />
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" href="/mahasiswa">Batal</a>
                <button class="btn btn-primary" type="submit" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="btn__spinner" aria-hidden="true"></span>
                    }
                    @(_isSaving ? "Menyimpan..." : "Simpan")
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private readonly MahasiswaFormModel _model = new();
    private List<DosenModel> _dosen = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadErrorMessage;

    private bool IsEditMode => Id.HasValue;

    private string PageTitle => IsEditMode ? "Edit Mahasiswa" : "Tambah Mahasiswa";

    private string PageSubtitle => IsEditMode
        ? "Perbarui informasi mahasiswa dan dosen wali, lalu simpan perubahan."
        : "Lengkapi informasi mahasiswa baru untuk ditambahkan ke sistem akademik.";

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditMode)
        {
            _model.Angkatan = Math.Clamp(DateTime.Today.Year, 2020, 2026);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadErrorMessage = null;
        StateHasChanged();

        try
        {
            var dosenTask = DosenService.GetAllAsync();
            var mahasiswaTask = IsEditMode
                ? MahasiswaService.GetByIdAsync(Id!.Value)
                : null;

            if (mahasiswaTask is null)
            {
                await dosenTask;
            }
            else
            {
                await Task.WhenAll(dosenTask, mahasiswaTask);
            }

            var dosenResult = await dosenTask;

            if (!dosenResult.Success)
            {
                _loadErrorMessage = dosenResult.Message;
                return;
            }

            _dosen = (dosenResult.Data ?? new List<DosenModel>())
                .OrderBy(dosen => dosen.NamaDosen)
                .ToList();

            if (mahasiswaTask is null)
            {
                return;
            }

            var mahasiswaResult = await mahasiswaTask;

            if (!mahasiswaResult.Success || mahasiswaResult.Data is null)
            {
                _loadErrorMessage = mahasiswaResult.Message;
                return;
            }

            _model.Nim = mahasiswaResult.Data.Nim;
            _model.NamaMahasiswa = mahasiswaResult.Data.NamaMahasiswa;
            _model.Email = mahasiswaResult.Data.Email;
            _model.Angkatan = mahasiswaResult.Data.Angkatan;
            _model.DosenId = mahasiswaResult.Data.DosenId;
        }
        catch (Exception)
        {
            _loadErrorMessage = "Tidak dapat terhubung ke server. Pastikan API sudah berjalan.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        StateHasChanged();

        bool success;
        string message;

        if (IsEditMode)
        {
            var updateResult = await MahasiswaService.UpdateAsync(Id!.Value, _model);
            success = updateResult.Success;
            message = updateResult.Message;
        }
        else
        {
            var createResult = await MahasiswaService.CreateAsync(_model);
            success = createResult.Success;
            message = createResult.Message;
        }

        if (success)
        {
            var title = IsEditMode ? "Mahasiswa berhasil diperbarui" : "Mahasiswa berhasil ditambahkan";
            ToastService.ShowSuccess(title, message);
            Navigation.NavigateTo("/mahasiswa");
            return;
        }

        var errorTitle = IsEditMode ? "Gagal memperbarui mahasiswa" : "Gagal menambahkan mahasiswa";
        ToastService.ShowError(errorTitle, message);

        _isSaving = false;
        StateHasChanged();
    }
}
