@page "/dosen/tambah"
@page "/dosen/edit/{Id:int}"
@inject IDosenService DosenService
@inject ToastService ToastService
@inject NavigationManager Navigation

<div class="page-head">
    <a class="text-link" href="/dosen">← Kembali ke daftar</a>
    <p class="eyebrow">Data dosen</p>
    <h1 class="page-title">@PageTitle</h1>
    <p class="page-subtitle">@PageSubtitle</p>
</div>

@if (_isLoading)
{
    <section class="preview-section" aria-label="Memuat data dosen">
        <LoadingState Count="1" />
    </section>
}
else if (_loadErrorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data dosen tidak dapat dimuat"
                    Message="@_loadErrorMessage"
                    OnRetry="LoadDosenAsync" />
        <a class="btn btn-ghost btn--block" href="/dosen">Kembali ke daftar</a>
    </section>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="preview-section">
            <div class="card">
                <div class="form-group">
                    <label class="form-label" for="nidn">NIDN</label>
                    <InputText class="form-control"
                               id="nidn"
                               @bind-Value="_model.Nidn"
                               placeholder="cth. 0412078601" />
                    <ValidationMessage For="() => _model.Nidn" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="nama">Nama dosen</label>
                    <InputText class="form-control"
                               id="nama"
                               @bind-Value="_model.NamaDosen"
                               placeholder="cth. Dr. Anindita Rahmawati" />
                    <ValidationMessage For="() => _model.NamaDosen" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <InputText class="form-control"
                               id="email"
                               type="email"
                               @bind-Value="_model.Email"
                               placeholder="nama@kampus.ac.id" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="prodi">Program studi</label>
                    <InputText class="form-control"
                               id="prodi"
                               @bind-Value="_model.Prodi"
                               placeholder="cth. Teknik Informatika" />
                    <ValidationMessage For="() => _model.Prodi" />
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" href="/dosen">Batal</a>
                <button class="btn btn-primary" type="submit" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="btn__spinner" aria-hidden="true"></span>
                    }
                    @(_isSaving ? "Menyimpan..." : "Simpan")
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private readonly DosenFormModel _model = new();
    private bool _isLoading;
    private bool _isSaving;
    private string? _loadErrorMessage;

    private bool IsEditMode => Id.HasValue;

    private string PageTitle => IsEditMode ? "Edit Dosen" : "Tambah Dosen";

    private string PageSubtitle => IsEditMode
        ? "Perbarui informasi dosen, lalu simpan perubahan."
        : "Lengkapi informasi dosen baru untuk ditambahkan ke sistem akademik.";

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            await LoadDosenAsync();
        }
    }

    private async Task LoadDosenAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _isLoading = true;
        _loadErrorMessage = null;
        StateHasChanged();

        var result = await DosenService.GetByIdAsync(Id.Value);

        if (result.Success && result.Data is not null)
        {
            _model.Nidn = result.Data.Nidn;
            _model.NamaDosen = result.Data.NamaDosen;
            _model.Email = result.Data.Email;
            _model.Prodi = result.Data.Prodi;
        }
        else
        {
            _loadErrorMessage = result.Message;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        StateHasChanged();

        bool success;
        string message;

        if (IsEditMode)
        {
            var updateResult = await DosenService.UpdateAsync(Id!.Value, _model);
            success = updateResult.Success;
            message = updateResult.Message;
        }
        else
        {
            var createResult = await DosenService.CreateAsync(_model);
            success = createResult.Success;
            message = createResult.Message;
        }

        if (success)
        {
            var title = IsEditMode ? "Dosen berhasil diperbarui" : "Dosen berhasil ditambahkan";
            ToastService.ShowSuccess(title, message);
            Navigation.NavigateTo("/dosen");
            return;
        }

        var errorTitle = IsEditMode ? "Gagal memperbarui dosen" : "Gagal menambahkan dosen";
        ToastService.ShowError(errorTitle, message);

        _isSaving = false;
        StateHasChanged();
    }
}
