@page "/dosen/tambah"
@page "/dosen/edit/{Id:int}"
@inherits EntityFormPageBase<DosenFormModel>
@inject IDosenService DosenService

<div class="page-head">
    <a class="text-link" href="/dosen">← Kembali ke daftar</a>
    <p class="eyebrow">Data dosen</p>
    <h1 class="page-title">@PageTitle</h1>
    <p class="page-subtitle">@PageSubtitle</p>
</div>

@if (IsLoading)
{
    <section class="preview-section" aria-label="Memuat data dosen">
        <LoadingState Count="1" />
    </section>
}
else if (LoadErrorMessage is not null)
{
    <section class="preview-section">
        <ErrorState Title="Data dosen tidak dapat dimuat"
                    Message="@LoadErrorMessage"
                    OnRetry="LoadAsync" />
        <a class="btn btn-ghost btn--block" href="/dosen">Kembali ke daftar</a>
    </section>
}
else
{
    <EditForm Model="FormModel" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="preview-section">
            <div class="card">
                <div class="form-group">
                    <label class="form-label" for="nidn">NIDN</label>
                    <InputText class="form-control"
                               id="nidn"
                               @bind-Value="FormModel.Nidn"
                               placeholder="cth. 0412078601" />
                    <ValidationMessage For="() => FormModel.Nidn" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="nama">Nama dosen</label>
                    <InputText class="form-control"
                               id="nama"
                               @bind-Value="FormModel.NamaDosen"
                               placeholder="cth. Dr. Anindita Rahmawati" />
                    <ValidationMessage For="() => FormModel.NamaDosen" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <InputText class="form-control"
                               id="email"
                               type="email"
                               @bind-Value="FormModel.Email"
                               placeholder="nama@kampus.ac.id" />
                    <ValidationMessage For="() => FormModel.Email" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="prodi">Program studi</label>
                    <InputText class="form-control"
                               id="prodi"
                               @bind-Value="FormModel.Prodi"
                               placeholder="cth. Teknik Informatika" />
                    <ValidationMessage For="() => FormModel.Prodi" />
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" href="/dosen">Batal</a>
                <button class="btn btn-primary" type="submit" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="btn__spinner" aria-hidden="true"></span>
                    }
                    @(IsSaving ? "Menyimpan..." : "Simpan")
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsEditMode => Id.HasValue;

    private string PageTitle => IsEditMode ? "Edit Dosen" : "Tambah Dosen";

    private string PageSubtitle => IsEditMode
        ? "Perbarui informasi dosen, lalu simpan perubahan."
        : "Lengkapi informasi dosen baru untuk ditambahkan ke sistem akademik.";

    protected override string ListPath => "/dosen";

    protected override string SaveSuccessTitle => IsEditMode
        ? "Dosen berhasil diperbarui"
        : "Dosen berhasil ditambahkan";

    protected override string SaveErrorTitle => IsEditMode
        ? "Gagal memperbarui dosen"
        : "Gagal menambahkan dosen";

    protected override async Task LoadFormAsync()
    {
        if (!IsEditMode)
        {
            return;
        }

        var result = await DosenService.GetByIdAsync(Id!.Value);

        if (result.Success && result.Data is not null)
        {
            FormModel.Nidn = result.Data.Nidn;
            FormModel.NamaDosen = result.Data.NamaDosen;
            FormModel.Email = result.Data.Email;
            FormModel.Prodi = result.Data.Prodi;
        }
        else
        {
            LoadErrorMessage = result.Message;
        }
    }

    protected override async Task<ServiceResult> SaveModelAsync()
    {
        if (IsEditMode)
        {
            return await DosenService.UpdateAsync(Id!.Value, FormModel);
        }

        var result = await DosenService.CreateAsync(FormModel);

        return result.Success
            ? ServiceResult.Ok(result.Message)
            : ServiceResult.Fail(result.Message);
    }
}
